# Normalize line endings: store and check out text files as LF.
# Keeps Prettier (endOfLine: lf) happy on Windows and avoids CRLF churn.
* text=auto eol=lf

# Shell scripts and git hooks must stay LF regardless of platform.
*.sh text eol=lf
.husky/* text eol=lf

# Binary files git should never touch.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary
