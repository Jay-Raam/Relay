# ---------------------------------------------------------------------------
# Relay — environment template. Copy to .env and fill in.
# Every required variable is documented here; config/env.ts validates with Zod
# on boot, so a missing/bad var crashes at startup, not at 2am in production.
# ---------------------------------------------------------------------------

# Runtime
NODE_ENV=development

# Database (PostgreSQL 16 + TimescaleDB, PgBouncer in front)
DATABASE_URL=postgres://relay:relay@localhost:6432/relay
DATABASE_REPLICA_URL=postgres://relay:relay@localhost:6432/relay

# Cache (Redis — hot query cache, latest-value store, rate-limit counters)
REDIS_URL=redis://localhost:6379

# MQTT broker (EMQX in prod, Mosquitto in dev) — QoS 1
MQTT_URL=mqtt://localhost:1883
MQTT_USERNAME=
MQTT_PASSWORD=

# GraphQL API
API_PORT=4000
API_HOST=0.0.0.0

# Frontend (Next.js)
NEXT_PUBLIC_GRAPHQL_URL=http://localhost:4000/graphql

# Observability
LOG_LEVEL=info
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
