# ---------------------------------------------------------------------------
# Relay — environment template. Copy to .env and fill in.
# Every required variable is documented here; config/env.ts validates with Zod
# on boot, so a missing/bad var crashes at startup, not at 2am in production.
# ---------------------------------------------------------------------------

# Runtime
NODE_ENV=development

# Database — hosted PostgreSQL + TimescaleDB (Timescale Cloud). Paste the
# connection string from the service page; keep ?sslmode=require. See docs/HOSTED-SETUP.md.
DATABASE_URL=postgres://tsdbadmin:CHANGE_ME@YOUR_SERVICE.tsdb.cloud.timescale.com:PORT/tsdb?sslmode=require

# MQTT broker — hosted (HiveMQ Cloud), TLS on port 8883, QoS 1.
# Use mqtts:// (not mqtt://) and the credentials you created in the HiveMQ console.
MQTT_URL=mqtts://YOUR_CLUSTER.s1.eu.hivemq.cloud:8883
MQTT_USERNAME=CHANGE_ME
MQTT_PASSWORD=CHANGE_ME

# Cache (Redis) — OPTIONAL, hosted (e.g. Upstash). Use rediss:// (TLS). Powers the
# latest-value cache and live push. Leave it unset and Relay still works: the API
# reads from the database and the dashboard falls back to polling.
# REDIS_URL=rediss://default:CHANGE_ME@YOUR_HOST.upstash.io:6379

# GraphQL API
API_PORT=4000
API_HOST=0.0.0.0

# Frontend (Next.js)
NEXT_PUBLIC_GRAPHQL_URL=http://localhost:4000/graphql

# Observability
LOG_LEVEL=info
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
